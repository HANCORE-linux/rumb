#!/usr/bin/env bash

# shellcheck disable=SC2016 # jq programs are passed to emit() in single quotes

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: rumb-scan --stream [--since <time>] [--offline]

Read-only health scan of a NixOS system. It reads system generations, the
flake lock, the journal and /proc. It never builds, switches or collects garbage.

  --stream        Print one JSON event per line while the checks run, then keep
                  following new generations and the journal
  --since <time>  Look for problems since <time>, e.g. "7 days ago"
                  (default: when the current generation was created)
  --offline       Do not ask the flake input remotes or fetch the NixOS news
EOF
}

stream=0
since_arg=""
offline=0
following=0

while (($#)); do
  case "$1" in
    --stream) stream=1 ;;
    --since)
      if [[ -z ${2:-} ]]; then
        usage >&2
        exit 1
      fi
      since_arg=$2
      shift
      ;;
    --offline) offline=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if ((!stream)); then
  usage >&2
  exit 1
fi

for cmd in jq nix; do
  if ! command -v "$cmd" >/dev/null; then
    echo "Missing required command: $cmd" >&2
    exit 1
  fi
done

PROFILES=/nix/var/nix/profiles
FLAKE_DIR=${RUMB_FLAKE:-/etc/nixos}
# appimage-run (and other FHS sandboxes) show the host /etc at /.host-etc.
if [[ -z ${RUMB_FLAKE:-} && ! -r $FLAKE_DIR/flake.lock && -r /.host-etc/nixos/flake.lock ]]; then
  FLAKE_DIR=/.host-etc/nixos
fi

if [[ ! -d $PROFILES ]]; then
  echo "no NixOS system generations here (/nix/var/nix/profiles is missing): rumb reads a NixOS system" >&2
  exit 1
fi

new_tmp() {
  tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/rumb-scan.XXXXXX") || return 1
  touch "$tmp/updates.tsv" "$tmp/problems.tsv" "$tmp/news.tsv" "$tmp/activity.tsv"
}

new_tmp || exit 1
trap 'rm -rf "$tmp"' EXIT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 130' INT

to_iso() { [[ -n $1 ]] && date -d "@$1" --iso-8601=seconds; }

emit() {
  ((stream)) || return 0
  jq -cn "$@"
}

step() {
  ((following)) && return 0
  emit --arg stage "$1" --arg label "$2" '{event: "step", stage: $stage, label: $label}'
}

done_step() {
  ((following)) && return 0
  emit --arg stage "$1" --arg label "$2" --argjson value "$3" '{event: "done", stage: $stage, label: $label, value: $value}'
}

tsv_json() {
  local file=$1
  shift
  jq -Rn '[inputs | split("\u001f") as $row | [$ARGS.positional, $row] | transpose | map({(.[0]): .[1]}) | add]' \
    --args "$@" <"$file"
}

# --- Store paths ---

declare -A owner_cache=()

# Sets REPLY to "name" and REPLY_VERSION to "version" for a /nix/store path
# (hash-name-version/...), or both to "" outside the store.
store_package() {
  local rest
  REPLY="" REPLY_VERSION=""
  [[ $1 =~ ^/nix/store/[a-z0-9]{32}-([^/]+) ]] || return 0
  rest=${BASH_REMATCH[1]}
  REPLY=${rest%%-[0-9]*}
  [[ $rest == *-[0-9]* ]] && REPLY_VERSION=${rest#"$REPLY"-}
  return 0
}

# Sets REPLY to the package that holds a path, or to "" when it is not in the store.
owner_of() {
  local real
  if [[ -z ${owner_cache[$1]+set} ]]; then
    real=$(readlink -f -- "$1" 2>/dev/null)
    store_package "$real"
    owner_cache[$1]=$REPLY
  fi
  REPLY=${owner_cache[$1]}
}

# Sets REPLY to the package behind a journal line: its executable, the kernel,
# or a program of that name on PATH; "" when none is found.
journal_owner() {
  local path=$1
  REPLY=""
  if [[ -z $path && $2 == kernel ]]; then
    REPLY=${kernel_package:-}
    return
  fi
  [[ -n $path ]] || path=$(command -v -- "$2" 2>/dev/null) || return 0
  [[ $path == /* ]] && owner_of "$path"
  return 0
}

# --- Generations ---

gen_numbers=()
declare -A gen_time=()

list_generations() {
  local link n current_real
  gen_numbers=()
  gen_time=()
  for link in "$PROFILES"/system-*-link; do
    [[ -L $link ]] || continue
    n=${link##*/system-}
    n=${n%-link}
    [[ $n =~ ^[0-9]+$ ]] || continue
    gen_numbers+=("$n")
    gen_time[$n]=$(stat -c %Y -- "$link" 2>/dev/null || echo 0)
  done
  ((${#gen_numbers[@]})) && mapfile -t gen_numbers < <(printf '%s\n' "${gen_numbers[@]}" | sort -n)
  current_gen=""
  current_real=$(readlink -f /run/current-system 2>/dev/null)
  for n in "${gen_numbers[@]}"; do
    if [[ $(readlink -f "$PROFILES/system-$n-link" 2>/dev/null) == "$current_real" ]]; then
      current_gen=$n
    fi
  done
  if [[ -z $current_gen ]]; then
    current_gen=$(readlink "$PROFILES/system" 2>/dev/null)
    current_gen=${current_gen#system-}
    current_gen=${current_gen%-link}
  fi
  [[ $current_gen =~ ^[0-9]+$ ]] || current_gen=""
}

# Sets REPLY to the newest generation older than $1.
previous_gen() {
  local n prev=""
  for n in "${gen_numbers[@]}"; do
    ((n < $1)) && prev=$n
  done
  REPLY=$prev
}

# Prints "action<US>name<US>version" for each package whose version differs
# between two generations, read from nix store diff-closures.
generation_changes() {
  NO_COLOR=1 nix --extra-experimental-features nix-command store diff-closures "$PROFILES/system-$1-link" "$PROFILES/system-$2-link" 2>/dev/null |
    sed 's/\x1b\[[0-9;]*m//g' |
    awk '
      function last(list,   parts, count) { count = split(list, parts, ", "); return parts[count] }
      function version(list,   parts, count, i, out) {
        count = split(list, parts, ", ")
        for (i = 1; i <= count; i++) if (parts[i] !~ /^[+-]?[0-9.]+ [KMGT]iB$/) out = out (out == "" ? "" : ", ") parts[i]
        return out
      }
      / → / {
        name = $0
        sub(/: .*/, "", name)
        rest = $0
        sub(/^[^:]*: /, "", rest)
        split(rest, side, " → ")
        old = version(side[1])
        new = version(side[2])
        if (old == "ε" || new == "ε" || old == new) next
        if (old == "∅") { printf "installed\x1f%s\x1f%s\n", name, last(new); next }
        if (new == "∅") { printf "removed\x1f%s\x1f%s\n", name, last(old); next }
        printf "changed\x1f%s\x1f%s -> %s\n", name, last(old), last(new)
      }'
}

# --- Time windows ---

set_baseline() {
  list_generations
  last_upgrade_epoch=""
  [[ -n $current_gen ]] && last_upgrade_epoch=${gen_time[$current_gen]}
  [[ $last_upgrade_epoch == 0 ]] && last_upgrade_epoch=""

  if [[ -n $since_arg ]]; then
    since_epoch=$(date -d "$since_arg" +%s 2>/dev/null) || return 1
  elif [[ -n $last_upgrade_epoch ]]; then
    since_epoch=$last_upgrade_epoch
  else
    since_epoch=$(date -d '7 days ago' +%s)
  fi

  news_since_epoch=${last_upgrade_epoch:-$(date -d '30 days ago' +%s)}
}

if ! set_baseline; then
  echo "Invalid --since time: $since_arg" >&2
  exit 1
fi

set_window() {
  window_start=$(date -d "$(date +%F) 14 days ago" +%s)
  ((since_epoch < window_start)) && window_start=$since_epoch
  local oldest
  oldest=$(date -d "$(date +%F) 89 days ago" +%s)
  ((window_start < oldest)) && window_start=$oldest
  query_start=$((since_epoch < window_start ? since_epoch : window_start))
}
set_window

emit_start() {
  local upgraded='[]'
  if [[ -n $current_gen ]]; then
    previous_gen "$current_gen"
    if [[ -n $REPLY ]]; then
      upgraded=$(generation_changes "$REPLY" "$current_gen" | awk -F'\x1f' '$1 == "changed" { print $2 " " $3 }' |
        head -n 400 | jq -Rsc 'split("\n") | map(select(length > 0))') || upgraded='[]'
    fi
  fi
  emit --arg last_upgrade "$(to_iso "$last_upgrade_epoch")" --arg since "$(to_iso "$since_epoch")" \
    --arg now "$(date --iso-8601=seconds)" --argjson upgraded "${upgraded:-[]}" \
    '{event: "start", last_upgrade: (if $last_upgrade == "" then null else $last_upgrade end), problems_since: $since, now: $now, last_upgraded: $upgraded}'
}
emit_start

# --- Pending updates: flake inputs behind their remotes ---

declare -A pending=()
update_errors=()

# Inputs whose staleness can leave the session, the boot or the shell unpatched.
CORE_INPUTS=(nixpkgs nixpkgs-stable nixpkgs_2 home-manager niri niri-unstable noctalia umbriel)

is_core() {
  local name
  for name in "${CORE_INPUTS[@]}"; do
    [[ $1 == "$name" ]] && return 0
  done
  return 1
}

# Prints the commit a branch (or HEAD) of a git remote points to: with git when
# it is installed, else through the smart HTTP endpoint with curl.
remote_head() {
  local url=$1 ref=$2 target=HEAD
  [[ $ref == HEAD ]] || target=refs/heads/$ref
  if command -v git >/dev/null; then
    timeout 15 git ls-remote "$url" "$target" 2>/dev/null | awk 'NR == 1 { print $1 }'
  else
    curl -fsS --max-time 15 "${url%.git}.git/info/refs?service=git-upload-pack" 2>/dev/null |
      tr '\0' '\n' | grep -aoE "[0-9a-f]{40} $target\$" | head -n 1 | cut -d' ' -f1
  fi
}

check_updates() {
  pending=()
  update_errors=()
  checked=(flake)
  : >"$tmp/updates.tsv"
  step updates "checking flake inputs"
  local lock=$FLAKE_DIR/flake.lock name rev lastmod remote age risk reason core failed=0 now
  if [[ ! -r $lock ]]; then
    update_errors+=(flake)
    done_step updates "checking flake inputs" null
  elif ((offline)); then
    done_step updates "checking flake inputs" 0
  else
    jq -r '.nodes.root.inputs as $root | .nodes as $nodes
        | $root | to_entries[] | select(.value | type == "string") | .key as $input | $nodes[.value] as $node
        | select($node.locked.type == "github" or $node.locked.type == "git")
        | [$input,
           (if $node.locked.type == "github" then "https://github.com/\($node.locked.owner)/\($node.locked.repo)" else $node.locked.url end),
           ($node.original.ref // "HEAD"), $node.locked.rev, $node.locked.lastModified] | @tsv' "$lock" >"$tmp/inputs.tsv" 2>/dev/null
    export -f remote_head
    xargs -d '\n' -P 8 -I{} bash -c '
        IFS=$'"'"'\t'"'"' read -r name url ref rev lastmod <<<"$1"
        head=$(remote_head "$url" "$ref")
        printf "%s\t%s\t%s\t%s\n" "$name" "$rev" "$lastmod" "${head:-ERR}"
      ' _ {} <"$tmp/inputs.tsv" >"$tmp/remotes.tsv"
    now=$(date +%s)
    while IFS=$'\t' read -r name rev lastmod remote; do
      if [[ $remote == ERR ]]; then
        failed=$((failed + 1))
        continue
      fi
      [[ $remote != "$rev" ]] || continue
      age=$(((now - lastmod) / 86400))
      core=false
      is_core "$name" && core=true
      if $core && ((age >= 90)); then
        risk=high
      elif $core && ((age >= 30)); then
        risk=medium
      elif ((age >= 180)); then
        risk=medium
      else
        risk=low
      fi
      reason="locked $age days ago"
      ((age == 1)) && reason="locked 1 day ago"
      $core && reason="critical input, $reason"
      pending[$name]="${rev:0:7} -> ${remote:0:7}"
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$name" "${rev:0:7}" "${remote:0:7}" flake commit "$risk" "$reason" >>"$tmp/updates.tsv"
    done <"$tmp/remotes.tsv"
    if ((failed > 0 && failed == $(wc -l <"$tmp/remotes.tsv"))); then
      update_errors+=(flake)
      done_step updates "checking flake inputs" null
    else
      done_step updates "checking flake inputs" "$(wc -l <"$tmp/updates.tsv")"
    fi
  fi

  tsv_json "$tmp/updates.tsv" name old new source bump risk reason >"$tmp/updates.json"
  emit --slurpfile updates "$tmp/updates.json" --arg checked "${checked[*]}" --args \
    '{event: "stage", stage: "updates", data: {updates: $updates[0], update_check_errors: $ARGS.positional, checked: ($checked | split(" "))}}' \
    "${update_errors[@]}"
}
check_updates

# --- Current problems ---

# Sets REPLY to the pending flake input that ships a package carrying its name.
input_update() {
  local name
  for name in "${!pending[@]}"; do
    [[ $name == nixpkgs* || $name == home-manager ]] && continue
    if [[ $1 == "$name" || $1 == "$name"-* ]]; then
      REPLY="$name ${pending[$name]}"
      return 0
    fi
  done
  REPLY=""
  return 1
}

crash_details() {
  local exe=$1 own=${2:-} pid="" epoch="" info maps frame module path
  local -A listed=()
  crash_signal="" crash_frames="" crash_last="" crash_libraries=""
  read -r pid epoch < <(jq -r --arg exe "$exe" --argjson since "$since_epoch" \
    '[.[]? | select(.exe == $exe and .time / 1000000 >= $since)] | max_by(.time) // empty | "\(.pid) \(.time / 1000000 | floor)"' "$tmp/cores.json" 2>/dev/null)
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  crash_last=$(LC_ALL=C date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null)
  info=$(LC_ALL=C timeout 5 coredumpctl info "$pid" --no-pager 2>/dev/null) || true
  crash_signal=$(sed -n 's/^ *Signal: [0-9]* (\([A-Z0-9]*\)).*/SIG\1/p' <<<"$info" | head -n 1)
  crash_frames=$(awk '
    /Stack trace of thread/ { thread++; next }
    thread == 1 && /^ *#[0-9]+ / {
      name = $3
      module = $0
      sub(/^[^(]*\(/, "", module)
      sub(/ \+ .*/, "", module)
      sub(/\)$/, "", module)
      if (!started && (module ~ /^libc\.so/ || name ~ /panicking|panic_fmt|process5abort|abort_internal|rust_begin_unwind|backtrace/)) next
      started = 1
      if (name == "n/a") {
        offset = $0
        sub(/^.*\+ /, "", offset)
        sub(/\)$/, "", offset)
        print module " + " offset
      } else {
        print name " (" module ")"
      }
      if (++shown == 3) exit
    }' <<<"$info" | paste -sd '|')
  [[ -n $crash_frames ]] || return 0
  maps=$(LC_ALL=C timeout 5 journalctl -q --no-pager --all -o json -n 1 "COREDUMP_PID=$pid" "COREDUMP_EXE=$exe" 2>/dev/null |
    jq -r '.COREDUMP_PROC_MAPS // "" | if type == "array" then implode else . end' 2>/dev/null)
  [[ -n $maps ]] || return 0
  while IFS= read -r frame; do
    if [[ $frame == *" ("*")" ]]; then
      module=${frame##* (}
      module=${module%)}
    else
      module=${frame%% + *}
    fi
    [[ -n $module && -z ${listed[$module]+set} ]] || continue
    listed[$module]=1
    path=$(awk -v base="$module" '{ n = split($6, parts, "/") } n > 1 && parts[n] == base { print $6; exit }' <<<"$maps")
    [[ -n $path ]] || continue
    owner_of "$path"
    [[ -n $REPLY && $REPLY != "$own" ]] && crash_libraries+="${crash_libraries:+|}$module $REPLY"
  done < <(tr '|' '\n' <<<"$crash_frames")
  return 0
}

add_problem() {
  local kind=$1 subject=$2 count=$3 package=$4 path=${5:-} signal=${6:-} frames=${7:-} last=${8:-} message=${9:-} libraries=${10:-} first=${11:-} status update=""

  if [[ $kind == config ]]; then
    status=config
  elif [[ -z $package && ( -z $path || ! -e $path ) ]]; then
    status=unknown-owner
  elif [[ -z $package ]]; then
    status=not-packaged
  elif input_update "$package"; then
    status=possibly-fixed
    update=$REPLY
  else
    status=no-update
  fi

  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$kind" "${subject//[[:cntrl:]]/ }" "$count" "$package" "$status" "$update" "$signal" "${frames//[[:cntrl:]]/ }" "$last" "${message//[[:cntrl:]]/ }" "${libraries//[[:cntrl:]]/ }" "$first" >>"$tmp/problems.tsv"
}

# Package changes between consecutive generations inside the window, one row per package:
# day, action, name, time, kept, version
collect_day_changes() {
  local n prev day time action name version kept old new
  : >"$tmp/day_changes.tsv"
  for n in "${gen_numbers[@]}"; do
    ((${gen_time[$n]} >= window_start)) || continue
    previous_gen "$n"
    prev=$REPLY
    [[ -n $prev ]] || continue
    day=$(date -d "@${gen_time[$n]}" +%F)
    time=$(date -d "@${gen_time[$n]}" +%H:%M)
    while IFS=$'\x1f' read -r action name version; do
      kept=-
      if [[ $action == changed ]]; then
        action=upgraded
        old=${version%% -> *}
        new=${version##* -> }
        if [[ $(printf '%s\n%s\n' "$old" "$new" | sort -V | head -n 1) == "$new" ]]; then
          action=downgraded
        fi
        kept="generation $prev"
      fi
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$day" "$action" "$name" "$time" "$kept" "$version"
    done < <(generation_changes "$prev" "$n") >>"$tmp/day_changes.tsv"
  done
}

collect_problems() {
  local count exe source scope unit fragment package units config_errors day today journal_total failed_total row path first
  local -a scope_flag rows day_paths
  local -A crash_days=() error_days=()
  problem_errors=()
  : >"$tmp/problems.tsv"
  : >"$tmp/activity.tsv"
  : >"$tmp/cores.json"

  kernel_package=linux

  if command -v coredumpctl >/dev/null; then
    step problems "reading crash reports"
    if ! LC_ALL=C coredumpctl list --since "@$query_start" --json=short --no-pager >"$tmp/cores.json" 2>"$tmp/cores.err" &&
      ! grep -q 'No coredumps found' "$tmp/cores.err"; then
      problem_errors+=(crashes)
    fi
    jq -r --argjson since "$since_epoch" '.[]? | select(.time / 1000000 >= $since) | .exe // empty | gsub("[[:cntrl:]]"; " ")' "$tmp/cores.json" 2>/dev/null | sort >"$tmp/crashes.txt"
    while read -r count exe; do
      [[ -n $exe ]] || continue
      owner_of "$exe"
      package=$REPLY
      crash_details "$exe" "$package"
      add_problem crash "$exe" "$count" "$package" "$exe" "$crash_signal" "$crash_frames" "$crash_last" "" "$crash_libraries"
    done < <(uniq -c "$tmp/crashes.txt" | sort -rn)
    if [[ " ${problem_errors[*]} " == *" crashes "* ]]; then
      done_step problems "reading crash reports" null
    else
      done_step problems "reading crash reports" "$(jq --argjson since "$since_epoch" '[.[]? | select(.time / 1000000 >= $since)] | length' "$tmp/cores.json" 2>/dev/null || echo 0)"
    fi
  fi

  step problems "reading journal errors"
  journalctl -p err --since "@$query_start" -o json \
    --output-fields=_EXE,SYSLOG_IDENTIFIER,_TRANSPORT,_COMM,MESSAGE,_SYSTEMD_UNIT -q --no-pager >"$tmp/journal.json" 2>/dev/null || problem_errors+=(journal)

  journal_source='def s: if type == "string" then . else null end;
    def recent: select((.SYSLOG_IDENTIFIER | s) != "systemd-coredump" and (.__REALTIME_TIMESTAMP | tonumber / 1000000) >= $since);
    def source: (if (._TRANSPORT | s) == "kernel" then "kernel"
      elif (._EXE | s) then ._EXE
      else "ident:" + ((.SYSLOG_IDENTIFIER | s) // (._COMM | s) // "unknown") end) | gsub("[[:cntrl:]]"; " ");'
  declare -A journal_last=() journal_message=()
  while IFS=$'\x1f' read -r source last message; do
    journal_last[$source]=$last
    journal_message[$source]=$message
  done < <(jq -rn --argjson since "$since_epoch" "$journal_source"'
      reduce (inputs | recent) as $line ({};
        ($line | source) as $key | ($line.__REALTIME_TIMESTAMP | tonumber) as $at
        | if (.[$key].at // -1) < $at then .[$key] = {at: $at, message: (($line.MESSAGE | s) // "binary message")} else . end)
      | to_entries[]
      | [.key, (.value.at / 1000000 | floor | strflocaltime("%m-%d %H:%M")),
         (.value.message | gsub("[[:cntrl:]]"; " ") | if length > 300 then .[:299] + "…" else . end)] | join("\u001f")' \
    "$tmp/journal.json" 2>/dev/null)

  jq -r --argjson since "$since_epoch" "$journal_source"' recent | source' "$tmp/journal.json" 2>/dev/null | sort >"$tmp/sources.txt"

  journal_total=0
  while read -r count source; do
    [[ -n $source ]] || continue
    journal_total=$((journal_total + count))
    case $source in
      kernel) add_problem journal "kernel" "$count" "$kernel_package" "" "" "" "${journal_last[$source]:-}" "${journal_message[$source]:-}" ;;
      /*)
        owner_of "$source"
        add_problem journal "$source" "$count" "$REPLY" "$source" "" "" "${journal_last[$source]:-}" "${journal_message[$source]:-}"
        ;;
      *) add_problem journal "${source#ident:}" "$count" "" "" "" "" "${journal_last[$source]:-}" "${journal_message[$source]:-}" ;;
    esac
  done < <(uniq -c "$tmp/sources.txt" | sort -rn)
  if [[ " ${problem_errors[*]} " == *" journal "* ]]; then
    done_step problems "reading journal errors" null
  else
    done_step problems "reading journal errors" "$journal_total"
  fi

  # Crashes and journal errors per day, for the activity chart
  while read -r count day; do
    [[ -n $day ]] && crash_days[$day]=$count
  done < <(jq -r '.[]?.time // empty | . / 1000000 | floor | strflocaltime("%F")' "$tmp/cores.json" 2>/dev/null | sort | uniq -c)
  while read -r count day; do
    [[ -n $day ]] && error_days[$day]=$count
  done < <(jq -r 'select(.SYSLOG_IDENTIFIER != "systemd-coredump") | .__REALTIME_TIMESTAMP // empty
      | tonumber / 1000000 | floor | strflocaltime("%F")' "$tmp/journal.json" 2>/dev/null | sort | uniq -c)

  day=$(date -d "@$window_start" +%F)
  today=$(date +%F)
  while [[ ! $day > $today ]]; do
    printf '%s\x1f%s\x1f%s\n' "$day" "${crash_days[$day]:-0}" "${error_days[$day]:-0}" >>"$tmp/activity.tsv"
    day=$(date -d "$day + 1 day" +%F)
  done

  # The programs behind each day's crashes and errors, and what each generation changed that day
  jq -c '[.[]? | select(.exe) | (.time / 1000000 | floor) as $at | {day: ($at | strflocaltime("%F")), at: $at, subject: (.exe | gsub("[[:cntrl:]]"; " "))}]
      | group_by(.day, .subject) | map({day: .[0].day, kind: "crash", subject: .[0].subject, count: length, first: (map(.at) | min | strflocaltime("%H:%M"))})' \
    "$tmp/cores.json" >"$tmp/day_crashes.json" 2>/dev/null || echo '[]' >"$tmp/day_crashes.json"
  jq -nc --argjson since "$since_epoch" "$journal_source"'
      [inputs | select((.SYSLOG_IDENTIFIER | s) != "systemd-coredump")
        | (.__REALTIME_TIMESTAMP | tonumber / 1000000 | floor) as $at | {day: ($at | strflocaltime("%F")), at: $at, subject: (source | sub("^ident:"; ""))}]
      | group_by(.day, .subject) | map({day: .[0].day, kind: "error", subject: .[0].subject, count: length, first: (map(.at) | min | strflocaltime("%H:%M"))})' \
    "$tmp/journal.json" >"$tmp/day_errors.json" 2>/dev/null || echo '[]' >"$tmp/day_errors.json"
  mapfile -t day_paths < <(jq -r '.[]?.subject | select(startswith("/"))' "$tmp/day_crashes.json" "$tmp/day_errors.json" 2>/dev/null | sort -u)
  printf 'kernel\x1f%s\n' "$kernel_package" >"$tmp/day_owners.tsv"
  for source in "${day_paths[@]}"; do
    owner_of "$source"
    printf '%s\x1f%s\n' "$source" "$REPLY" >>"$tmp/day_owners.tsv"
  done
  while IFS= read -r source; do
    path=$(command -v -- "$source" 2>/dev/null) && [[ $path == /* ]] || continue
    owner_of "$path"
    printf '%s\x1f%s\n' "$source" "$REPLY" >>"$tmp/day_owners.tsv"
  done < <(jq -r '.[]?.subject | select(startswith("/") or . == "kernel" | not)' "$tmp/day_errors.json" 2>/dev/null | sort -u)
  jq -Rn '[inputs | split("\u001f") | select(.[1] != "") | {(.[0]): .[1]}] | add // {}' <"$tmp/day_owners.tsv" >"$tmp/day_owners.json"
  collect_day_changes
  jq -n '[inputs | select(._SYSTEMD_UNIT | type == "string") | {unit: ._SYSTEMD_UNIT, at: (.__REALTIME_TIMESTAMP | tonumber / 1000000 | floor)}]
      | group_by(.unit) | map({key: .[0].unit, value: (map(.at) | min | strflocaltime("%F %H:%M"))}) | from_entries' \
    "$tmp/journal.json" >"$tmp/unit_first.json" 2>/dev/null || echo '{}' >"$tmp/unit_first.json"

  step problems "checking failed units"
  failed_total=0
  rows=()
  for scope in system user; do
    scope_flag=()
    [[ $scope == user ]] && scope_flag=(--user)
    if ! units=$(systemctl "${scope_flag[@]}" --failed --no-legend --plain 2>/dev/null); then
      problem_errors+=("$scope units")
      continue
    fi
    while read -r unit _; do
      [[ -n $unit ]] || continue
      fragment=$(systemctl "${scope_flag[@]}" show -P FragmentPath -- "$unit" 2>/dev/null)
      rows+=("$unit"$'\x1f'"$fragment"$'\x1f'"$scope")
    done <<<"$units"
  done
  for row in "${rows[@]}"; do
    IFS=$'\x1f' read -r unit fragment scope <<<"$row"
    scope_flag=()
    [[ $scope == user ]] && scope_flag=(--user)
    package=""
    if [[ -n $fragment ]]; then
      owner_of "$fragment"
      package=$REPLY
    fi
    first=$(jq -r --arg unit "$unit" '.[$unit] // empty' "$tmp/unit_first.json" 2>/dev/null)
    if [[ -z $first ]]; then
      first=$(systemctl "${scope_flag[@]}" show -P InactiveEnterTimestamp -- "$unit" 2>/dev/null)
      [[ -n $first ]] && first=$(date -d "$first" '+%F %H:%M' 2>/dev/null)
    fi
    add_problem failed-unit "$unit" 1 "$package" "$fragment" "" "" "" "" "" "$first"
    failed_total=$((failed_total + 1))
  done
  if [[ " ${problem_errors[*]} " == *" units "* ]]; then
    done_step problems "checking failed units" null
  else
    done_step problems "checking failed units" "$failed_total"
  fi

  config_errors=null
  if command -v niri >/dev/null; then
    step problems "checking niri config"
    config_errors=$(NO_COLOR=1 niri validate 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | awk '/config is valid/ { ok = 1 } /ERROR|Error:/ { bad++ } END { print ok ? 0 : (bad ? bad : "x") }')
    if ! [[ $config_errors =~ ^[0-9]+$ ]]; then
      problem_errors+=(niri)
      config_errors=null
    elif ((config_errors > 0)); then
      add_problem config "niri config errors" "$config_errors" ""
    fi
    done_step problems "checking niri config" "$config_errors"
  fi

  tsv_json "$tmp/problems.tsv" kind subject count package status update signal frames last message libraries first |
    jq 'map(.count |= tonumber | .subject |= sub("^/nix/store/[a-z0-9]{32}-"; ""))' >"$tmp/problems.json"
  tsv_json "$tmp/activity.tsv" date crashes errors |
    jq --slurpfile crashes "$tmp/day_crashes.json" --slurpfile errors "$tmp/day_errors.json" --slurpfile owners "$tmp/day_owners.json" --rawfile changes "$tmp/day_changes.tsv" '
      def by_day: group_by(.day) | map({key: .[0].day, value: map(del(.day))}) | from_entries;
      (($crashes[0] // []) + ($errors[0] // []) | map(. + (($owners[0] // {})[.subject] // empty | {package: .}) // .) | by_day) as $sources
      | ($changes | split("\n") | map(select(length > 0) | gsub("[[:cntrl:]]"; " ") | split(" ") | {day: .[0], action: .[1], name: .[2], time: .[3], kept: (.[4] | if . == "-" then "" else . end), version: (.[5:] | join(" "))}) | by_day) as $changed
      | map(.crashes |= tonumber | .errors |= tonumber | .sources = (($sources[.date] // []) | map(.subject |= sub("^/nix/store/[a-z0-9]{32}-"; ""))) | .changes = ($changed[.date] // []))' >"$tmp/activity.json"
  journalctl --list-boots -o json --no-pager 2>/dev/null |
    jq -c --argjson start "$window_start" '[.[]? | .first_entry / 1000000 | floor | select(. >= $start) | strflocaltime("%F %H:%M")]' >"$tmp/boots.json" 2>/dev/null
  [[ -s $tmp/boots.json ]] || echo '[]' >"$tmp/boots.json"
  emit --slurpfile problems "$tmp/problems.json" --slurpfile activity "$tmp/activity.json" --slurpfile boots "$tmp/boots.json" --argjson config_errors "$config_errors" --args \
    '{event: "stage", stage: "problems", data: {problems: $problems[0], activity: $activity[0], boots: $boots[0], problem_check_errors: $ARGS.positional, config_errors: $config_errors}}' \
    "${problem_errors[@]}"
}
collect_problems

# --- Anatomy ---

# Prints the store name of a system link target, without the hash.
system_part() {
  local target
  target=$(readlink -f "$1/$2" 2>/dev/null) || return 0
  [[ $target == /nix/store/* ]] || return 0
  target=${target#/nix/store/}
  target=${target%%/*}
  printf '%s' "${target#*-}"
}

journal_line='def s: if type == "string" then . else null end;
  select((.SYSLOG_IDENTIFIER | s) != "systemd-coredump")
  | (.__REALTIME_TIMESTAMP | tonumber / 1000000 | floor) as $at
  | {time: ($at | strflocaltime("%H:%M:%S")),
     day: ($at | strflocaltime("%Y-%m-%d")),
     ident: (if (._TRANSPORT | s) == "kernel" then "kernel" else ((.SYSLOG_IDENTIFIER | s) // (._COMM | s) // "unknown") end),
     exe: ((._EXE | s) // ""),
     program: ((((._EXE | s) // "") | split("/") | last // "") as $exe | if $exe != "" then $exe else ((._COMM | s) // "") end),
     message: ((.MESSAGE | s) // "binary message"),
     priority: ((.PRIORITY | s) // ""),
     unit: ((._SYSTEMD_USER_UNIT | s) // (._SYSTEMD_UNIT | s) // "")}'

collect_anatomy() {
  local os desktop kernel_running kernel_installed="" reboot_pending=false closure_bytes=0
  local uptime_seconds nvidia_loaded="" nvidia_installed="" niri_running="" niri_installed="" niri_bin store_paths system_packages user_packages
  local old_generations old_names booted_real current_real pid exe file n row
  local -a old_list

  os=$(. /etc/os-release 2>/dev/null && printf '%s %s' "${NAME:-}" "${VERSION_ID:-}")
  os=${os% }

  current_real=$(readlink -f /run/current-system 2>/dev/null)
  booted_real=$(readlink -f /run/booted-system 2>/dev/null)

  step anatomy "reading the running kernel"
  kernel_running=$(uname -r)
  kernel_installed=$(system_part /run/current-system kernel)
  kernel_installed=${kernel_installed#linux-}
  if [[ -n $booted_real && -n $current_real ]]; then
    for file in kernel initrd kernel-modules; do
      [[ $(readlink -f "/run/booted-system/$file" 2>/dev/null) == "$(readlink -f "/run/current-system/$file" 2>/dev/null)" ]] || reboot_pending=true
    done
  fi
  uptime_seconds=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
  uptime_seconds=${uptime_seconds%.*}
  [[ $uptime_seconds =~ ^[0-9]+$ ]] || uptime_seconds=null
  done_step anatomy "reading the running kernel" "$(jq -cn --arg running "$kernel_running" --arg installed "$kernel_installed" \
    --arg package "$kernel_package" --argjson uptime "$uptime_seconds" --argjson reboot "$reboot_pending" \
    '{running: $running, installed: $installed, package: $package, uptime_seconds: $uptime, reboot_pending: $reboot}')"

  if [[ -r /sys/module/nvidia/version ]]; then
    step anatomy "reading the loaded nvidia module"
    nvidia_loaded=$(tr -d '[:space:]' </sys/module/nvidia/version 2>/dev/null)
    nvidia_installed=$(nix-store -q --requisites /run/current-system 2>/dev/null | sed -n 's|^/nix/store/[a-z0-9]*-nvidia-x11-\([0-9][0-9.]*\)$|\1|p' | head -n 1)
    done_step anatomy "reading the loaded nvidia module" "$(jq -cn --arg loaded "$nvidia_loaded" --arg installed "$nvidia_installed" \
      '{loaded: $loaded, installed: $installed}')"
  fi

  desktop=${XDG_CURRENT_DESKTOP:-}
  if [[ -n ${NIRI_SOCKET:-} ]] && command -v niri >/dev/null; then
    step anatomy "reading the running niri"
    niri_running=$(niri msg version 2>/dev/null | awk -F': *' 'tolower($1) ~ /compositor/ { split($2, word, " "); print word[1]; exit }')
    niri_bin=$(readlink -f "$(command -v niri)" 2>/dev/null)
    store_package "$niri_bin"
    niri_installed=$REPLY_VERSION
    desktop="niri $niri_running"
    desktop=${desktop% }
    done_step anatomy "reading the running niri" "$(jq -cn --arg running "$niri_running" --arg installed "$niri_installed" \
      '{running: $running, installed: $installed}')"
  fi

  step anatomy "listing the system closure"
  store_paths=$(nix-store -q --requisites /run/current-system 2>/dev/null | wc -l)
  system_packages=$(nix-store -q --references /run/current-system/sw 2>/dev/null | wc -l)
  user_packages=$(nix-store -q --references "/etc/profiles/per-user/${USER:-$(id -un)}" 2>/dev/null | wc -l)
  old_generations=$((${#gen_numbers[@]} > 0 ? ${#gen_numbers[@]} - 1 : 0))
  old_names=""
  mapfile -t old_list < <(for n in "${gen_numbers[@]}"; do
    [[ $n == "$current_gen" ]] || printf '%s %s\n' "$n" "${gen_time[$n]}"
  done | sort -k1,1nr | head -n 40)
  for row in "${old_list[@]}"; do
    old_names+="generation ${row% *} · $(date -d "@${row#* }" '+%m-%d %H:%M')"$'\n'
  done
  done_step anatomy "listing the system closure" "$(jq -cn --argjson store_paths "$store_paths" --argjson old "$old_generations" \
    '{store_paths: $store_paths, old_generations: $old}')"

  step anatomy "measuring the system closure"
  closure_bytes=$(nix --extra-experimental-features nix-command path-info -S /run/current-system 2>/dev/null | awk '{ print $2 }')
  [[ $closure_bytes =~ ^[0-9]+$ ]] || closure_bytes=0
  done_step anatomy "measuring the system closure" "$closure_bytes"

  grep -sH ' (deleted)$' /proc/[0-9]*/maps | awk '$(NF - 1) ~ /^\/nix\/store\// {
      pid = $1; sub(/^\/proc\//, "", pid); sub(/\/maps:.*/, "", pid); print pid "\x1f" $(NF - 1)
    }' | sort -u >"$tmp/stale_maps.tsv"
  for pid in $(cut -d$'\x1f' -f1 "$tmp/stale_maps.tsv" | sort -u); do
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) && printf '%s\x1f%s\n' "$pid" "${exe% (deleted)}"
  done >"$tmp/stale_exes.tsv"
  awk -F'\x1f' 'NR == FNR { exe[$1] = $2; next } $1 in exe { print exe[$1] "\x1f" $2 }' "$tmp/stale_exes.tsv" "$tmp/stale_maps.tsv" | sort -u |
    while IFS=$'\x1f' read -r exe file; do
      store_package "$file"
      printf '%s\x1f%s\x1f%s\n' "$exe" "$file" "$REPLY"
    done >"$tmp/stale.tsv"
  jq -Rn '[inputs | split("\u001f")] | group_by(.[0]) | map({program: (.[0][0] | split("/") | last), files: (map(.[1] + " " + .[2]) | join("|"))})' \
    <"$tmp/stale.tsv" >"$tmp/stale.json"

  journalctl -p err --since "@$since_epoch" -n 50 -o json \
    --output-fields=SYSLOG_IDENTIFIER,_COMM,_EXE,MESSAGE,_TRANSPORT,PRIORITY,_SYSTEMD_UNIT,_SYSTEMD_USER_UNIT -q --no-pager 2>/dev/null |
    jq -c "$journal_line" 2>/dev/null >"$tmp/journal_lines.ndjson"
  while IFS=$'\x1f' read -r file exe; do
    journal_owner "$file" "$exe"
    printf '%s\x1f%s\x1f%s\n' "$file" "$exe" "$REPLY"
  done < <(jq -r '[.exe, .ident] | join("\u001f")' "$tmp/journal_lines.ndjson" 2>/dev/null | sort -u) >"$tmp/journal_owners.tsv"
  jq -Rn '[inputs | split("\u001f") | {(.[0] + "\u001f" + .[1]): .[2]}] | add // {}' <"$tmp/journal_owners.tsv" >"$tmp/journal_owners.json"
  jq -sc --slurpfile owners "$tmp/journal_owners.json" 'map(. + {package: ($owners[0][.exe + "\u001f" + .ident] // "")} | del(.exe))' \
    "$tmp/journal_lines.ndjson" >"$tmp/journal_lines.json" 2>/dev/null
  [[ -s $tmp/journal_lines.json ]] || echo '[]' >"$tmp/journal_lines.json"

  emit --arg hostname "$(uname -n)" --arg os "$os" --arg desktop "$desktop" --argjson generation "${current_gen:-null}" \
    --arg kernel_running "$kernel_running" --arg kernel_installed "$kernel_installed" --arg kernel_package "$kernel_package" \
    --argjson reboot_pending "$reboot_pending" --argjson closure_bytes "$closure_bytes" \
    --argjson store_paths "$store_paths" --argjson system_packages "$system_packages" --argjson user_packages "$user_packages" \
    --argjson old_generations "$old_generations" --arg old_names "$old_names" \
    --argjson uptime_seconds "$uptime_seconds" --arg nvidia_loaded "$nvidia_loaded" --arg nvidia_installed "$nvidia_installed" \
    --arg compositor_running "$niri_running" --arg compositor_installed "$niri_installed" \
    --slurpfile journal "$tmp/journal_lines.json" --slurpfile stale "$tmp/stale.json" \
    '{event: "stage", stage: "anatomy", data: {hostname: $hostname, os: $os, desktop: $desktop, generation: $generation,
      store_paths: $store_paths, system_packages: $system_packages, user_packages: $user_packages, closure_bytes: $closure_bytes,
      old_generations: $old_generations, old_generation_names: ($old_names | split("\n") | map(select(length > 0))),
      kernel_running: $kernel_running, kernel_installed: $kernel_installed, kernel_package: $kernel_package, reboot_pending: $reboot_pending,
      uptime_seconds: $uptime_seconds, nvidia_loaded: $nvidia_loaded, nvidia_installed: $nvidia_installed,
      compositor_running: $compositor_running, compositor_installed: $compositor_installed,
      journal: $journal[0], stale_programs: $stale[0]}}'
}
collect_anatomy

# --- NixOS news ---

collect_news() {
  local news_count i pub pub_epoch title link manual
  news_error=0
  : >"$tmp/news.tsv"
  if ((offline)); then
    echo '[]' >"$tmp/news.json"
    emit '{event: "stage", stage: "news", data: {news: [], news_check_failed: false}}'
    return 0
  fi
  step news "fetching NixOS news"
  if command -v xmllint >/dev/null &&
    curl -fsS --max-time 10 https://nixos.org/blog/announcements-rss.xml -o "$tmp/news.xml" 2>/dev/null &&
    [[ $(xmllint --nonet --xpath 'count(/rss/channel)' "$tmp/news.xml" 2>/dev/null) == 1 ]]; then
    news_count=$(xmllint --nonet --xpath 'count(//item)' "$tmp/news.xml" 2>/dev/null)
    [[ $news_count =~ ^[0-9]+$ ]] || news_count=0
    for ((i = 1; i <= news_count; i++)); do
      pub=$(xmllint --nonet --xpath "string(//item[$i]/pubDate)" "$tmp/news.xml" 2>/dev/null)
      pub_epoch=$(date -d "$pub" +%s 2>/dev/null) || continue
      ((pub_epoch > news_since_epoch)) || continue
      title=$(xmllint --nonet --xpath "string(//item[$i]/title)" "$tmp/news.xml" 2>/dev/null)
      link=$(xmllint --nonet --xpath "string(//item[$i]/link)" "$tmp/news.xml" 2>/dev/null)
      manual=false
      [[ ${title,,} == *breaking* || ${title,,} == *"manual intervention"* || ${title,,} == *"action required"* ]] && manual=true
      printf '%s\x1f%s\x1f%s\x1f%s\n' "$(date -d "@$pub_epoch" +%F)" "${title//[[:cntrl:]]/ }" "${link//[[:cntrl:]]/}" "$manual" >>"$tmp/news.tsv"
    done
  else
    news_error=1
  fi
  if ((news_error)); then
    done_step news "fetching NixOS news" null
  else
    done_step news "fetching NixOS news" "$(wc -l <"$tmp/news.tsv")"
  fi

  tsv_json "$tmp/news.tsv" date title link manual_intervention |
    jq 'map(.manual_intervention |= (. == "true"))' >"$tmp/news.json"
  emit --slurpfile news "$tmp/news.json" --argjson news_error "$news_error" \
    '{event: "stage", stage: "news", data: {news: $news[0], news_check_failed: ($news_error == 1)}}'
}
collect_news

# --- Preflight ---

collect_preflight() {
  step preflight "checking /nix and /boot space"
  local disk_total_bytes disk_used_bytes free_bytes boot_total_bytes boot_free_bytes free_ok rollback=null
  read -r disk_total_bytes disk_used_bytes free_bytes < <(df --output=size,used,avail --block-size=1 /nix 2>/dev/null | tail -n 1)
  [[ $free_bytes =~ ^[0-9]+$ ]] || free_bytes=0
  [[ $disk_total_bytes =~ ^[0-9]+$ ]] || disk_total_bytes=0
  [[ $disk_used_bytes =~ ^[0-9]+$ ]] || disk_used_bytes=0
  free_ok=false
  ((free_bytes >= 10 * 1024 * 1024 * 1024)) && free_ok=true
  read -r boot_total_bytes boot_free_bytes < <(df --output=size,avail --block-size=1 /boot 2>/dev/null | tail -n 1)
  [[ $boot_total_bytes =~ ^[0-9]+$ ]] || boot_total_bytes=0
  [[ $boot_free_bytes =~ ^[0-9]+$ ]] || boot_free_bytes=0
  if [[ -n $current_gen ]]; then
    previous_gen "$current_gen"
    [[ -n $REPLY ]] && rollback=$REPLY
  fi
  done_step preflight "checking /nix and /boot space" "$free_bytes"

  emit --argjson free_bytes "$free_bytes" --argjson free_ok "$free_ok" --argjson rollback "$rollback" \
    --argjson total "$disk_total_bytes" --argjson used "$disk_used_bytes" \
    --argjson boot_total "$boot_total_bytes" --argjson boot_free "$boot_free_bytes" \
    '{event: "stage", stage: "preflight", data: {free_bytes: $free_bytes, free_ok: $free_ok, disk_total_bytes: $total, disk_used_bytes: $used,
      rollback_generation: $rollback, boot_total_bytes: $boot_total, boot_free_bytes: $boot_free}}'
}
collect_preflight

recheck() {
  new_tmp || return
  set_baseline || return
  set_window
  emit_start
  check_updates
  collect_problems
  collect_anatomy
  collect_news
  collect_preflight
  rm -rf "$tmp"
}

# --- Following ---

follow_sources() {
  local journal_pid="" parent=$$
  (
    last=$(readlink "$PROFILES/system" 2>/dev/null)
    while kill -0 "$parent" 2>/dev/null; do
      sleep 5
      current=$(readlink "$PROFILES/system" 2>/dev/null)
      if [[ $current != "$last" ]]; then
        last=$current
        number=${current#system-}
        number=${number%-link}
        printf 'L switched to generation %s\n' "$number"
      fi
    done
  ) &
  if command -v journalctl >/dev/null; then
    journalctl -f -n0 -q -p err -o json --output-fields=SYSLOG_IDENTIFIER,_COMM,_EXE,MESSAGE,_TRANSPORT,PRIORITY,_SYSTEMD_UNIT,_SYSTEMD_USER_UNIT 2>/dev/null > >(sed -u 's/^/J /') &
    journal_pid=$!
  fi
  tail -f --pid=$$ /dev/null 2>/dev/null
  [[ -n $journal_pid ]] && kill "$journal_pid" 2>/dev/null
  wait
}

follow_events() {
  local line message due=0 timeout status file name
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 143' TERM
  while true; do
    timeout=60
    if ((due)); then
      if ((SECONDS >= due)); then
        due=0
        recheck
        continue
      fi
      timeout=$((due - SECONDS))
    fi
    ((timeout > 0)) || timeout=1
    IFS= read -r -t "$timeout" line
    status=$?
    ((status > 128)) && continue
    ((status == 0)) || break
    case ${line:0:2} in
      'L ')
        message=${line:2}
        emit --arg line "$message" '{event: "activity", line: $line}'
        due=$((SECONDS + 3))
        ;;
      'J ')
        line=$(jq -c "$journal_line" <<<"${line:2}" 2>/dev/null)
        [[ -n $line ]] || continue
        IFS=$'\x1f' read -r file name < <(jq -r '[.exe, .ident] | join("\u001f")' <<<"$line")
        journal_owner "$file" "$name"
        jq -c --arg package "$REPLY" '{event: "journal"} + del(.exe) + {package: $package}' <<<"$line"
        ;;
    esac
  done
}

follow() {
  rm -rf "$tmp"
  following=1
  local parent=$PPID
  follow_sources | follow_events &
  while kill -0 "$parent" 2>/dev/null; do
    sleep 15
  done
}

emit --slurpfile updates "$tmp/updates.json" --slurpfile problems "$tmp/problems.json" --slurpfile news "$tmp/news.json" --slurpfile activity "$tmp/activity.json" \
  --arg generated "$(date --iso-8601=seconds)" --arg last_upgrade "$(to_iso "$last_upgrade_epoch")" --arg since "$(to_iso "$since_epoch")" \
  '{event: "result", forecast: {generated_at: $generated, last_upgrade: (if $last_upgrade == "" then null else $last_upgrade end), problems_since: $since,
    updates: $updates[0], news: $news[0], problems: $problems[0], activity: $activity[0]}}'
follow
